# Copy this to .env for local dev. `render workflows dev` loads it automatically.

# --- Typefully (the post source) ---
TYPEFULLY_API_KEY=zH...
# List your sets: curl -H "Authorization: Bearer $TYPEFULLY_API_KEY" \
#   https://api.typefully.com/v2/social-sets
TYPEFULLY_SOCIAL_SET_ID=00...
# Leave unset in production. `pnpm local:run` points it at the local stub so a
# run needs no Typefully key; the key travels to whatever host this names.
# TYPEFULLY_BASE_URL=http://localhost:8787

# --- @render-lab/tasks-slack ---
# Both are required. A note is a thread, and only the Web API returns the parent's
# ts that a reply needs. A leading "#" on the channel is optional. With neither,
# amplifier.postNote throws and the run fails.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=test-channel
# Leave unset in production. `pnpm local:run` points it at the local stub; the bot
# token travels to whatever host this names.
# SLACK_API_BASE_URL=http://localhost:8787/slack

# --- @render-lab/tasks-llm (the one-line post summary) ---
# Read by the Anthropic SDK inside the call, never by src/config.ts. Without it
# the note still posts, carrying the fallback text and the reason.
ANTHROPIC_API_KEY=sk-ant-...

# --- @render-lab/tasks-render-kv (announce-once state) ---
# Local only. On Render this is the amplifier-kv internal connection string, so
# do not copy this file or your .env into the Workflow service's environment.
REDIS_URL=redis://localhost:6379

# --- amplifier config ---
DRY_RUN=true                       # log the note instead of posting; unset posts to Slack
# AMPLIFIER_LOOKBACK_MINUTES=90    # covers the gap between the event and the run, plus retry backoff
# AMPLIFIER_GROUP_WINDOW_MINUTES=10
# AMPLIFIER_SETTLE_MINUTES=10      # 15 max, the retry budget on amplifier.handleEvent
# AMPLIFIER_SEEN_TTL_DAYS=30
# AMPLIFIER_LIMIT=25              # max 50; also the run's widest burst of Key Value calls
# AMPLIFIER_CALL_TO_ACTION=New Render social post! Please like and share when you have a minute   # lead line used only when the summary fails
# AMPLIFIER_SUMMARY_MODEL=anthropic/claude-sonnet-5   # provider prefix required; beats tasks-llm's own LLM_MODEL
# --- the Repost button (unset AMPLIFIER_REPOST_CHANNEL turns it off) ---
# AMPLIFIER_REPOST_CHANNEL=amplify-wider
# AMPLIFIER_REPOST_EMOJI=white_check_mark   # must be an emoji the workspace has
# SLACK_CLIENT_ID=1234.5678                 # Slack app, Basic Information
# SLACK_CLIENT_SECRET=...                   # read only by amplifier.saveUserToken
# SLACK_SIGNING_SECRET=...                  # signs the authorize link's state; same value the receiver has
# AMPLIFIER_PUBLIC_URL=https://amplifier-webhook.onrender.com   # the receiver's base URL, to build the OAuth redirect

# --- trigger layer (@render-lab/triggers): the webhook receiver only ---
# These only need dispatch credentials. The vendor keys above live on the
# Workflow service. The receiver does not read them.
# RENDER_API_KEY=rnd_...
# WORKFLOW_SLUG=amplifier
# TYPEFULLY_WEBHOOK_SECRET=whsec_...   # from Typefully, Settings > API, when the webhook is registered
# SLACK_SIGNING_SECRET=...             # Slack app, Basic Information. Verifies clicks and signs the OAuth state
# SLACK_CLIENT_ID=1234.5678            # builds the authorize link
# AMPLIFIER_PUBLIC_URL=http://localhost:3000   # only local; Render sets RENDER_EXTERNAL_URL
# PORT=3000                            # Render sets this in production; only needed locally
